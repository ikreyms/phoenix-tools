#!/usr/bin/env bash

# Resolve symlinks portably (no `readlink -f`, which older macOS lacks)
resolve_dir() {
    local src="$1" dir
    while [[ -L "$src" ]]; do
        dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
        src="$(readlink -- "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P -- "$(dirname -- "$src")" && pwd
}

PHOENIX_ROOT="$(resolve_dir "${BASH_SOURCE[0]}")"
export PHOENIX_ROOT

usage() {
    cat <<'EOF'
Usage: phoenix <command> [options]

Commands:
  setup [-t parent_dir] [-d name]   Clone all repos into a new project
  up    [-t project_dir] [-b]       Start containers and install dependencies
  update                            Update these tools
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    setup|up) exec "$PHOENIX_ROOT/libexec/phoenix-$cmd" "$@" ;;
    update)   git -C "$PHOENIX_ROOT" pull --ff-only ;;
    help|-h|--help) usage ;;
    *) printf 'Unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 1 ;;
esac