#!/usr/bin/env bash

# Resolve symlinks portably (no `readlink -f`, which older macOS lacks)
resolve_dir() {
    local src="$1" dir
    while [[ -L "$src" ]]; do
        dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
        src="$(readlink -- "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P -- "$(dirname -- "$src")" && pwd
}

PHOENIX_ROOT="$(resolve_dir "${BASH_SOURCE[0]}")"
export PHOENIX_ROOT

source "${PHOENIX_ROOT:?Run this through the 'phoenix' command}/lib/phoenix-lib" || exit 1

cmd="${1:-help}"
shift || true

case "$cmd" in
    setup|up) exec "$PHOENIX_ROOT/libexec/phoenix-$cmd" "$@" ;;
    update)   git -C "$PHOENIX_ROOT" pull --ff-only ;;
    help|-h|--help) usage ;;
    *) printf 'Unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 1 ;;
esac