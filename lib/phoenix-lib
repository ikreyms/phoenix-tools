RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

cleanup_on_interrupt() {
    printf '\n%b\n' "${RED}Interrupted. Removing partially cloned project...${NC}" >&2
    rm -rf -- "$rootpath"
    exit 130
}

clone_repo() {
    local repo_url="$1"
    local repo_path="$2"

    printf '%b\n' "${CYAN}Cloning $repo_url into $repo_path${NC}"

    if ! git clone "$repo_url" "$repo_path"; then
        printf '%b\n' "${RED}ERROR: Failed to clone $repo_url${NC}" >&2
        return 1
    fi

    printf '%b\n' "${GREEN}Successfully cloned $repo_url${NC}"
    echo
}

clone_with_cleanup() {
    if ! clone_repo "$@"; then
        printf '%b\n' "${RED}Setup failed. Removing partially cloned project...${NC}" >&2

        if ! rm -rf -- "$rootpath"; then
            printf '%b\n' "${RED}WARNING: Failed to clean up $rootpath${NC}" >&2
        fi

        return 1
    fi
}

checkout_branch() {
    local repo_name="$1"
    local repo_path="$2"
    local branch="$3"

    printf '%b\n' "${CYAN}Checking out $repo_name to $branch${NC}"

    if ! git -C "$repo_path" checkout "$branch"; then
        printf '%b\n' "${RED}ERROR: Git checkout failed. Repo: $repo_name, Branch: $branch${NC}" >&2
        return 1
    fi

    printf '%b\n' "${GREEN}Successfully checked out $repo_name to $branch${NC}"
    echo
}